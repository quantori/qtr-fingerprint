FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Install all dependencies needed for build and runtime
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    python3 \
    python3-pip \
    python3-dev \
    python3-numpy \
    libfreetype6-dev \
    libfontconfig1-dev \
    libcairo2-dev \
    libpango1.0-dev \
    libasio-dev \
    libgflags-dev \
    libtbb-dev \
    g++-12 \
    gcc-12 \
    catch2 \
    libboost-all-dev \
    curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -r -s /bin/false -m -d /app qtrservice

# Set compiler to GCC/G++ 12 initially (for RDKit)
RUN update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-12 100 \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-12 100

# Copy source code
COPY ./cpp /code
WORKDIR /code

# Build RDKit
RUN cd /code/third_party/rdkit && \
    mkdir -p build && cd build && \
    cmake \
      -DPy_ENABLE_SHARED=1 \
      -DRDK_INSTALL_INTREE=ON \
      -DRDK_INSTALL_STATIC_LIBS=OFF \
      -DRDK_BUILD_CPP_TESTS=ON  \
      -DRDK_BUILD_INCHI_SUPPORT=ON  \
      -DRDKIT_RDINCHILIB_BUILD=ON  \
      .. && \
    make -j 4

# Build QTR service
RUN cd /code && \
    mkdir -p build && \
    cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_STANDARD=20 -S . -B build && \
    cmake --build build --target qtr-service -j 4

EXPOSE 8080

CMD ["/bin/sh", "-c", "/code/build/bin/qtr-service --engine=${ENGINE:-BallTreeRDKit} --port=${PORT:-8080} --fpRatio=${FPRATIO:-2}"]
