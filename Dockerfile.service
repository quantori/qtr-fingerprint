# Multi-stage Docker build for QTR Fingerprint Service
# Stage 1: Build environment
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    python3 \
    python3-pip \
    python3-dev \
    python3-numpy \
    libfreetype6-dev \
    libfontconfig1-dev \
    libasio-dev \
    libgflags-dev \
    libtbb-dev \
    g++-9 \
    catch2 \
    libboost-all-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set up compiler alternatives
RUN update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-9 100 \
    && update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-9 100

# Copy source code
COPY . /qtr-fingerprint
WORKDIR /qtr-fingerprint

# Build RDKit
RUN cd cpp/third_party/rdkit && \
    mkdir -p build && cd build && \
    cmake \
      -DPy_ENABLE_SHARED=1 \
      -DRDK_INSTALL_INTREE=ON \
      -DRDK_INSTALL_STATIC_LIBS=OFF \
      -DRDK_BUILD_CPP_TESTS=OFF \
      -DRDK_BUILD_INCHI_SUPPORT=ON \
      -DRDKIT_RDINCHILIB_BUILD=ON \
      -DCMAKE_BUILD_TYPE=Release \
      .. && \
    make -j$(nproc)

# Build QTR service
RUN cd cpp && \
    mkdir -p build && \
    cmake -DCMAKE_BUILD_TYPE=Release -S . -B build && \
    cmake --build build --target qtr-service -j$(nproc)

# Stage 2: Runtime environment
FROM ubuntu:22.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies only
RUN apt-get update && apt-get install -y \
    libstdc++6 \
    libfreetype6 \
    libfontconfig1 \
    libtbb12 \
    libboost-filesystem1.74.0 \
    libboost-system1.74.0 \
    libboost-thread1.74.0 \
    curl \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN useradd -r -s /bin/false -m -d /app qtrservice

# Copy built service and dependencies
COPY --from=builder /qtr-fingerprint/cpp/build/service/qtr-service /app/qtr-service
COPY --from=builder /qtr-fingerprint/cpp/third_party/rdkit/build/lib/ /usr/local/lib/

# Copy sample CSV file for testing
COPY --from=builder /qtr-fingerprint/sample_molecules.csv /app/sample_molecules.csv

# Set up library path
ENV LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

# Set working directory and user
WORKDIR /app
RUN chown -R qtrservice:qtrservice /app
USER qtrservice

# Expose the service port
EXPOSE 8080

# Default command - start the service
CMD ["/bin/sh", "-c", "/app/qtr-service --engine=${ENGINE:-RDKit} --port=${PORT:-8080}"]